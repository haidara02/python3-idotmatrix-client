# Copy to .env and fill in. Times are HH:MM-HH:MM in TZ, and may wrap past midnight.

# Display MAC address from `docker compose run --rm idotmatrix scan`. "auto" uses the first IDM-* display found.
IDM_ADDRESS=auto
TZ=Australia/Sydney
# How commands are written over Bluetooth. `python -m service test` shows which one your display accepts.
WRITE_WITH_RESPONSE=true
# 5-100
BRIGHTNESS=60
# Optional: change brightness through the day, as time=percent pairs. Each one lasts until the next,
# and the last one carries on past midnight. Overrides BRIGHTNESS when set.
BRIGHTNESS_SCHEDULE=
# 16, 32 or 64 dots across. `python -m service test` shows which images the panel accepts.
PANEL_SIZE=32

# Screen off during these hours. Leave empty to never turn it off.
SLEEP=22:30-06:30

# Clock shown outside the train window. Styles 0-7, colour is R-G-B.
CLOCK_STYLE=0
CLOCK_COLOR=255-255-255
CLOCK_24H=false
CLOCK_DATE=true

# Free key from https://opendata.transport.nsw.gov.au (Trip Planner APIs). Leave empty to disable the train board.
TFNSW_API_KEY=
# Your station's stop ID, from `docker compose run --rm idotmatrix stops "<station name>"`. Central Station is 10111010.
STOP_ID=
# Matched against the platform name, e.g. "Platform 1". Leave empty for all platforms.
PLATFORM=Platform 1
LINE=T8
LINE_COLOR=0-149-76
# Trains departing sooner than this are hidden. The next train's minutes turn amber/red when it's time to leave. 0 disables.
WALK_MINUTES=0
TRAIN_WINDOW=07:30-09:00
TRAIN_DAYS=mon-fri
# Seconds between API calls
TRAIN_REFRESH=60
